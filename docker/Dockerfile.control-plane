# syntax=docker/dockerfile:1.7

ARG PYTHON_IMAGE=python:3.12-slim
ARG TAILSCALE_IMAGE=tailscale/tailscale:v1.98.8

FROM oven/bun:1.3.12-debian AS web-build
WORKDIR /app/apps/web
COPY apps/web/package.json apps/web/bun.lock ./
RUN --mount=type=cache,id=lazycloud-bun-cache-v2,target=/root/.bun/install/cache \
    bun install --frozen-lockfile
COPY apps/web ./
RUN bun run build

FROM ${TAILSCALE_IMAGE} AS tailscale

FROM ${PYTHON_IMAGE} AS python-manifests

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_HTTP_TIMEOUT=120 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:${PATH}"

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:0.11.29@sha256:eb2843a1e56fd9e30c7276ce1a52cba86e64c7b385f5e3279a0e08e02dd058fc /uv /uvx /bin/
COPY pyproject.toml uv.lock README.md alembic.ini ./
COPY packages/agent/pyproject.toml ./packages/agent/pyproject.toml
COPY packages/cache/pyproject.toml ./packages/cache/pyproject.toml
COPY packages/compute/pyproject.toml ./packages/compute/pyproject.toml
COPY packages/control/pyproject.toml ./packages/control/pyproject.toml
COPY packages/coordination/pyproject.toml ./packages/coordination/pyproject.toml
COPY packages/database/pyproject.toml ./packages/database/pyproject.toml
COPY packages/execution/pyproject.toml ./packages/execution/pyproject.toml
COPY packages/foundation/pyproject.toml ./packages/foundation/pyproject.toml
COPY packages/gateway/pyproject.toml ./packages/gateway/pyproject.toml
COPY packages/identity/pyproject.toml ./packages/identity/pyproject.toml
COPY packages/images/pyproject.toml ./packages/images/pyproject.toml
COPY packages/networking/pyproject.toml ./packages/networking/pyproject.toml
COPY packages/observability/pyproject.toml ./packages/observability/pyproject.toml
COPY packages/operations/pyproject.toml ./packages/operations/pyproject.toml
COPY packages/provider-clients/pyproject.toml ./packages/provider-clients/pyproject.toml
COPY packages/runner/pyproject.toml ./packages/runner/pyproject.toml
COPY packages/scheduler/pyproject.toml ./packages/scheduler/pyproject.toml
COPY packages/lazycloud/pyproject.toml ./packages/lazycloud/pyproject.toml
COPY packages/shared/pyproject.toml ./packages/shared/pyproject.toml
COPY packages/storage/pyproject.toml ./packages/storage/pyproject.toml
COPY packages/storage-client/pyproject.toml ./packages/storage-client/pyproject.toml
COPY packages/worker/pyproject.toml ./packages/worker/pyproject.toml
COPY packages/worker-repository/pyproject.toml ./packages/worker-repository/pyproject.toml
COPY packages/providers/aws/pyproject.toml ./packages/providers/aws/pyproject.toml
COPY apps/agent/pyproject.toml ./apps/agent/pyproject.toml
COPY apps/api/pyproject.toml ./apps/api/pyproject.toml
COPY apps/cache-server/pyproject.toml ./apps/cache-server/pyproject.toml
COPY apps/control-plane-ingress/pyproject.toml ./apps/control-plane-ingress/pyproject.toml
COPY apps/cli/pyproject.toml ./apps/cli/pyproject.toml
COPY apps/container-worker/pyproject.toml ./apps/container-worker/pyproject.toml
COPY apps/scheduler/pyproject.toml ./apps/scheduler/pyproject.toml
COPY apps/worker-bootstrap/pyproject.toml ./apps/worker-bootstrap/pyproject.toml

FROM scratch AS workspace-source
COPY packages /packages
COPY apps/agent /apps/agent
COPY apps/api /apps/api
COPY apps/cache-server /apps/cache-server
COPY apps/control-plane-ingress /apps/control-plane-ingress
COPY apps/cli /apps/cli
COPY apps/container-worker /apps/container-worker
COPY apps/scheduler /apps/scheduler
COPY apps/worker-bootstrap /apps/worker-bootstrap

FROM scratch AS managed-package-source
COPY packages/shared/pyproject.toml /packages/shared/pyproject.toml
COPY packages/shared/src /packages/shared/src
COPY packages/foundation/pyproject.toml /packages/foundation/pyproject.toml
COPY packages/foundation/src /packages/foundation/src
COPY packages/lazycloud/pyproject.toml /packages/lazycloud/pyproject.toml
COPY packages/lazycloud/src /packages/lazycloud/src
COPY packages/runner/pyproject.toml /packages/runner/pyproject.toml
COPY packages/runner/src /packages/runner/src

FROM python-manifests AS api-dependencies
RUN --mount=type=cache,id=lazycloud-uv-cache-v2,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package api --no-install-workspace

FROM api-dependencies AS api-install
COPY --from=workspace-source /packages ./packages
COPY --from=workspace-source /apps ./apps
RUN --mount=type=cache,id=lazycloud-uv-cache-v2,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package api --no-editable

FROM python-manifests AS scheduler-dependencies
RUN --mount=type=cache,id=lazycloud-uv-cache-v2,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package scheduler-app --no-install-workspace

FROM scheduler-dependencies AS scheduler-install
COPY --from=workspace-source /packages ./packages
COPY --from=workspace-source /apps ./apps
RUN --mount=type=cache,id=lazycloud-uv-cache-v2,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package scheduler-app --no-editable

FROM python-manifests AS cache-server-dependencies
RUN --mount=type=cache,id=lazycloud-uv-cache-v2,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package cache-server-app --no-install-workspace

FROM cache-server-dependencies AS cache-server-install
COPY --from=workspace-source /packages ./packages
COPY --from=workspace-source /apps ./apps
RUN --mount=type=cache,id=lazycloud-uv-cache-v2,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package cache-server-app --no-editable

FROM python-manifests AS control-plane-ingress-dependencies
RUN --mount=type=cache,id=lazycloud-uv-cache-v2,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package control-plane-ingress-app --no-install-workspace

FROM control-plane-ingress-dependencies AS control-plane-ingress-install
COPY --from=workspace-source /packages ./packages
COPY --from=workspace-source /apps ./apps
RUN --mount=type=cache,id=lazycloud-uv-cache-v2,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package control-plane-ingress-app --no-editable

FROM python-manifests AS worker-bootstrap-dependencies
RUN --mount=type=cache,id=lazycloud-uv-cache-v2,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package worker-bootstrap-app --no-install-workspace

FROM worker-bootstrap-dependencies AS worker-bootstrap-install
COPY --from=workspace-source /packages ./packages
COPY --from=workspace-source /apps ./apps
RUN --mount=type=cache,id=lazycloud-uv-cache-v2,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package worker-bootstrap-app --no-editable

FROM python-manifests AS cli-dependencies
RUN --mount=type=cache,id=lazycloud-uv-cache-v2,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package cli --no-install-workspace

FROM cli-dependencies AS cli-install
COPY --from=workspace-source /packages ./packages
COPY --from=workspace-source /apps ./apps
RUN --mount=type=cache,id=lazycloud-uv-cache-v2,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package cli --no-editable

FROM ${PYTHON_IMAGE} AS python-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    LAZYCLOUD_HOME=/var/lib/lazycloud \
    PATH="/app/.venv/bin:${PATH}"

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

FROM python-runtime AS api
ENV LAZYCLOUD_WEB_STATIC_DIR=/app/web-static
RUN apt-get update \
    && apt-get install -y --no-install-recommends skopeo \
    && rm -rf /var/lib/apt/lists/*
COPY --from=api-install /app/.venv /app/.venv
COPY --from=managed-package-source /packages /app/packages
COPY --from=web-build /app/apps/web/dist/client/ /app/web-static/
COPY --from=tailscale /usr/local/bin/tailscale /usr/local/bin/tailscale
COPY --from=tailscale /usr/local/bin/tailscaled /usr/local/bin/tailscaled
EXPOSE 9000
VOLUME ["/var/lib/lazycloud"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "from urllib.request import urlopen; urlopen('http://127.0.0.1:9000/health', timeout=3).read()"
CMD ["lazycloud-api", "--host", "0.0.0.0", "--port", "9000"]

FROM python-runtime AS scheduler
COPY --from=scheduler-install /app/.venv /app/.venv
COPY --from=managed-package-source /packages /app/packages
VOLUME ["/var/lib/lazycloud"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -m shared.process_liveness /tmp/lazycloud-scheduler.heartbeat --max-age-seconds 120
CMD ["lazycloud-scheduler", "--interval-seconds", "1.0", "--container-limit", "100"]

FROM python-runtime AS cache-server
COPY --from=cache-server-install /app/.venv /app/.venv
EXPOSE 7900
VOLUME ["/var/lib/lazycloud"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import socket; socket.create_connection(('127.0.0.1', 7900), timeout=3).close()"
CMD ["lazycloud-cache-server", "--host", "0.0.0.0", "--port", "7900", "--root", "/var/lib/lazycloud/cache"]

FROM python-runtime AS control-plane-ingress
COPY --from=control-plane-ingress-install /app/.venv /app/.venv
COPY --from=tailscale /usr/local/bin/tailscale /usr/local/bin/tailscale
COPY --from=tailscale /usr/local/bin/tailscaled /usr/local/bin/tailscaled
EXPOSE 9000 1995
VOLUME ["/var/lib/lazycloud"]
# Proves the address this publishes reaches a control plane, which is the whole
# of what it is for; listening locally would prove only that it started.
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=12 \
    CMD python -m control_plane_ingress_app.health_probe
CMD ["lazycloud-control-plane-ingress"]

FROM python-runtime AS worker-bootstrap
COPY --from=worker-bootstrap-install /app/.venv /app/.venv
VOLUME ["/var/lib/lazycloud"]
CMD ["lazycloud-worker-bootstrap", "--help"]

FROM python-runtime AS cli
COPY --from=cli-install /app/.venv /app/.venv
VOLUME ["/var/lib/lazycloud"]
CMD ["lazycloud-admin", "--help"]

FROM cli AS database-bootstrap
CMD ["lazycloud-admin", "database", "status"]
