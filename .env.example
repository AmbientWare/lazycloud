# Local development configuration. Never put production credentials in this file.
# Run `bash deploy/setup-local-env.sh` once per clone. It creates the private .env
# in the main checkout and links existing and future worktrees to that same file.
# Setup generates local infrastructure credentials. Fill the GitHub and Stripe
# test credentials, then run `docker compose up -d --build`.
# The public SDK/CLI uses explicit exported settings or profiles; it does not load
# this file. Internal CLI and API entrypoints load .env from the repository root.

# Local API and host-side state. Use an absolute state path in the private .env
# when all worktrees share a running stack.
LAZYCLOUD_HOME=~/.lazycloud/local
LAZYCLOUD_LOG_LEVEL=INFO
LAZYCLOUD_ENDPOINT=http://lazycloud.localhost:8000
LAZYCLOUD_GATEWAY_PUBLIC_HTTP_URL=http://lazycloud.localhost:8000
LAZYCLOUD_GATEWAY_RUNTIME_HTTP_URL=http://100.96.0.2:9000

# Keep the web on the local API. Export a different VITE_API_TARGET only for an
# explicitly requested remote-data preview.
VITE_API_TARGET=http://127.0.0.1:8000

# Local administrator bootstrap. Use a separate random token for this deployment.
LAZYCLOUD_TOKEN=
LAZYCLOUD_ADMINISTRATOR_GITHUB_USER_ID=
LAZYCLOUD_BACKEND_ROUTE_AUTH_KEY=

# Development GitHub App. The callback must match its registered callback URL.
LAZYCLOUD_GITHUB_CLIENT_ID=
LAZYCLOUD_GITHUB_CLIENT_SECRET=
LAZYCLOUD_GITHUB_REDIRECT_URI=http://lazycloud.localhost:8000/auth/github/callback

# Local PostgreSQL and Redis. Applications use PgBouncer; migrations use Postgres.
# Compose supplies its container addresses from the same POSTGRES_PASSWORD.
POSTGRES_PASSWORD=lazycloud
LAZYCLOUD_DATABASE_URL=postgresql+psycopg://lazycloud:lazycloud@localhost:6432/lazycloud
LAZYCLOUD_DATABASE_DIRECT_URL=postgresql+psycopg://lazycloud:lazycloud@localhost:5432/lazycloud
LAZYCLOUD_REDIS_URL=redis://localhost:6379/0

# Garage runs locally. The same S3 endpoint must be reachable by the browser,
# host worker and API. Compose resolves object-store.localhost to its service.
LAZYCLOUD_WORKSPACE_STORAGE_ISSUER=garage
LAZYCLOUD_OBJECT_STORE_ENDPOINT_URL=http://object-store.localhost:3900
LAZYCLOUD_OBJECT_STORE_REGION_NAME=garage
LAZYCLOUD_OBJECT_STORE_ACCESS_KEY_ID=
LAZYCLOUD_OBJECT_STORE_SECRET_ACCESS_KEY=
LAZYCLOUD_OBJECT_STORE_FORCE_PATH_STYLE=true
LAZYCLOUD_OBJECT_STORE_BUCKET=lazycloud-dev-objects
LAZYCLOUD_OBJECT_STORE_WORKSPACE_BUCKET_PREFIX=lazycloud-dev-workspace
LAZYCLOUD_GARAGE_ADMIN_ENDPOINT_URL=http://127.0.0.1:3903
LAZYCLOUD_GARAGE_ADMIN_TOKEN=
LAZYCLOUD_GARAGE_RPC_SECRET=

# Stripe test mode. Browser sign-in provisions billing and requires a test key.
# Use sk_test_ or rk_test_; webhook secrets belong to the test endpoint.
LAZYCLOUD_STRIPE_API_KEY=
LAZYCLOUD_STRIPE_WEBHOOK_SECRET=

# Optional external integrations. Scope credentials to development resources.
# Invitations need Resend. Customer domains need Cloudflare for SaaS.
LAZYCLOUD_RESEND_API_KEY=
LAZYCLOUD_RESEND_FROM_ADDRESS=LazyCloud Dev <noreply@lazycloud.dev>
LAZYCLOUD_RESEND_WEBHOOK_SECRET=
LAZYCLOUD_CLOUDFLARE_API_TOKEN=
LAZYCLOUD_CLOUDFLARE_ZONE_ID=

# Published artifacts may be read by a local deployment without using production
# operator credentials. Leave unset when not exercising managed capacity.
# LAZYCLOUD_RELEASE_MANIFEST_URL=
# LAZYCLOUD_RELEASE_HOST_MANIFEST_URL=
# LAZYCLOUD_AGENT_BINARY_DIR=

# Local ports. Keep the host-side URLs above in step with changes here.
LAZYCLOUD_COMPOSE_CONTROL_PLANE_PORT=8000
LAZYCLOUD_COMPOSE_TCP_INGRESS_PORT=1995
LAZYCLOUD_COMPOSE_POSTGRES_PORT=5432
LAZYCLOUD_COMPOSE_PGBOUNCER_PORT=6432
LAZYCLOUD_COMPOSE_REDIS_PORT=6379
LAZYCLOUD_COMPOSE_WORKLOAD_REGISTRY_PORT=5000
LAZYCLOUD_COMPOSE_OBJECT_STORE_PORT=3900
LAZYCLOUD_COMPOSE_OBJECT_STORE_ADMIN_PORT=3903
LAZYCLOUD_TCP_INGRESS_EXTERNAL_HOST=tcp.localhost

# Compose runs local capacity. Cloud capacity and public ingress are opt-in.
LAZYCLOUD_COMPOSE_CONTAINER_WORKER_CPU_MILLICORES=4000
LAZYCLOUD_COMPOSE_CONTAINER_WORKER_MEMORY_MIB=8192
LAZYCLOUD_COMPOSE_CONTAINER_WORKER_POOL=lazycloud
# COMPOSE_PROFILES=public-ingress
# LAZYCLOUD_PUBLIC_INGRESS_CREDENTIALS_FILE=
# LAZYCLOUD_PUBLIC_INGRESS_CLIENT_IP_HEADER=

# Optional AWS acceptance. Keep the development credential chain separate from
# production. Configure connected capacity only for an explicit provider run.
AWS_PROFILE=default-test
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
# LAZYCLOUD_COMPOSE_AWS_CONFIG_DIR=
# LAZYCLOUD_COMPOSE_AWS_PROFILE=control
# LAZYCLOUD_AWS_CONNECTION_CONTROL_PRINCIPAL_ARN=
# LAZYCLOUD_AWS_CAPACITY_INSTANCE_HOURLY_MICROS={}
# LAZYCLOUD_E2E_AWS_CUSTOMER_STACK_EXECUTION_ROLE_ARN=
