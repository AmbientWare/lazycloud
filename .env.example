# Configuration for the root Compose stack and the host shells that talk to it.
# Copy it to .env before the first `docker compose up`:
#
#   cp .env.example .env
#   chmod 600 .env
#   docker compose up -d --wait --build
#
# Compose reads .env for interpolation, so a name set here reaches the
# containers that consume it and the host CLIs that read the same name. Keys
# absent from this file have working defaults in compose.yaml; per-worker
# identity, worker paths, and worker tuning live in its
# `container-worker-configuration` config block rather than here.
#
# Empty values marked below are credentials. Fill them in .env and never here:
# .env is gitignored and is the only copy of some of them.

# Host-side CLI/SDK state and service logging.
LAZYCLOUD_HOME=.lazycloud/local
LAZYCLOUD_LOG_LEVEL=INFO

# Control-plane endpoint the host CLIs target. Without it a plain
# `lazycloud login` resolves the packaged hosted default instead of the local
# Compose stack.
LAZYCLOUD_ENDPOINT=http://localhost:8000

# Stable local administrator authority. Generate this once into .env; Compose
# mounts it only into administrator-bootstrap.
LAZYCLOUD_TOKEN=

# Who may sign in as that first administrator, as a GitHub numeric user id
# (curl -s https://api.github.com/users/<login>). Declaring it here is what makes
# a rebuilt stack land its operator straight back in as administrator instead of
# opening them a fresh member account. The token above keeps working with no
# provider involved, so this adds a way in rather than replacing one. Leave empty
# for an administrator reachable only by its token.
LAZYCLOUD_ADMINISTRATOR_GITHUB_USER_ID=

# The GitHub App people sign in through. The stack boots without these; only
# browser sign-in is unavailable, because every Compose step drives the platform
# with LAZYCLOUD_TOKEN rather than a session. The redirect URI must byte-match
# the callback registered on the App.
LAZYCLOUD_GITHUB_CLIENT_ID=
LAZYCLOUD_GITHUB_CLIENT_SECRET=
LAZYCLOUD_GITHUB_REDIRECT_URI=

# Direct database/Redis connections for host-shell `lazycloud-admin` commands.
# Required, not optional: which datastore a process talks to has no correct
# default, so a settings class that answered `localhost` when the environment
# was silent would point the process at whatever happens to be listening and
# report success. Compose supplies its own in-network values to the containers;
# these are what the host shell uses to reach the same stack.
LAZYCLOUD_DATABASE_URL=postgresql+psycopg://lazycloud:lazycloud@localhost:5432/lazycloud
LAZYCLOUD_REDIS_URL=redis://localhost:6379/0

# The password Postgres initializes with. The container-side DSN in compose.yaml
# interpolates the same name, so changing it here also requires changing the
# password in LAZYCLOUD_DATABASE_URL above and recreating the postgres volume —
# an already-initialized database keeps the password it was created with.
POSTGRES_PASSWORD=lazycloud

# Where the control plane publishes itself, and where it tells runtimes to call
# back. These are two different origins and setting one does not set the other:
# the public URL is what a browser, CLI, or remote node dials, while the runtime
# URL is what containers and workers inside the stack are handed once at start
# and hold for their whole life. A runtime URL that resolves only on the host
# produces containers that start, report ready, and reach nothing.
LAZYCLOUD_GATEWAY_PUBLIC_HTTP_URL=http://localhost:8000
LAZYCLOUD_GATEWAY_RUNTIME_HTTP_URL=http://100.96.0.2:9000

# Cloudflare for SaaS, which terminates TLS on hostnames a customer owns. Only
# domain registration needs these; every deployment already answers on a hostname
# under the public URL above without them, and the operations that do need them
# fail naming what is missing rather than doing nothing quietly.
#
# The token is scoped to `Zone > SSL and Certificates > Edit` on the zone the
# public URL names, and that zone needs Custom Hostnames enabled with its
# fallback origin set to the zone apex. The zone id is on the zone's overview.
LAZYCLOUD_CLOUDFLARE_API_TOKEN=
LAZYCLOUD_CLOUDFLARE_ZONE_ID=

# The payment provider customers are registered with. The stack boots without
# this and goes on metering and pricing usage, but it cannot register anybody or
# charge for what it priced, and it says so rather than carrying on quietly:
# browser sign-in registers the customer before it mints a session, so the
# callback fails naming this variable, and the scheduler's delivery sweep names
# it on every tick. Every Compose step drives the platform with LAZYCLOUD_TOKEN
# rather than a session, so those keep working.
#
# A restricted key (`rk_...`) works, but it needs write access to more than the
# card pages: Customers, Checkout Sessions, the Billing Portal, Products, Prices,
# Subscriptions, Payment Methods, Invoices, Billing Meters, Meter Events and
# Credit Grants. A key scoped to the card pages alone registers customers and
# then fails at the first subscription, which is after somebody has signed up.
#
# A `sk_test_`/`rk_test_` prefix is what marks test data. Nothing branches on it
# — there is one code path either way — but `publish-catalog` reports which kind
# it is writing into, and the billing e2e scenarios refuse to run against a live
# key, because they attach test cards and drive real charges.
LAZYCLOUD_STRIPE_API_KEY=

# The endpoint secret (`whsec_...`) deliveries are signed with — issued per
# endpoint when you register `POST /webhooks/stripe`, and a different secret from
# the key above. Without it the endpoint refuses every delivery, which is the
# safe direction: the URL is public and what it carries decides which card a
# customer is charged on.
LAZYCLOUD_STRIPE_WEBHOOK_SECRET=

# Shared secret that signs backend route credentials. At least 32 bytes, or the
# API refuses to start while building its route dialer.
LAZYCLOUD_BACKEND_ROUTE_AUTH_KEY=

# Public UDP address agents use for WireGuard. Compose publishes the default
# port on the Docker host; override the host when agents run on another machine.
# LAZYCLOUD_WIREGUARD_PUBLIC_ENDPOINT=<docker-host>:51820

# Object-store connection for host-shell `lazycloud-admin object` commands.
# The code defaults already target the Compose stack (host port 9002 with the
# local-dev credentials), so host shells need no configuration. Override only
# for a non-default stack, and prefer exporting in your shell over
# uncommenting here: this file is shared with Compose, which interpolates
# same-name values into service containers, and services must keep the
# in-network `http://object-store:9000` endpoint.
# LAZYCLOUD_OBJECT_STORE_ENDPOINT_URL=http://127.0.0.1:9002
# LAZYCLOUD_OBJECT_STORE_ACCESS_KEY_ID=lazycloud-local
# LAZYCLOUD_OBJECT_STORE_SECRET_ACCESS_KEY=lazycloud-local-secret
# LAZYCLOUD_OBJECT_STORE_BUCKET=lazycloud-objects
# LAZYCLOUD_OBJECT_STORE_REGION_NAME=us-east-1
# Path-style addressing, because the local object store serves no
# bucket-per-subdomain. A connected deployment on real S3 sets this false.
# LAZYCLOUD_OBJECT_STORE_FORCE_PATH_STYLE=true

# Presigned object-store endpoint. Image builds upload their archive from a
# build container, which has its own network namespace and only a minimal
# /etc/hosts, so it cannot resolve `object-store.localhost`. Point this at an
# address that namespace can route to: the host's own IP, not loopback.
# Remote nodes fetch objects from this origin, so it must name an address they
# can reach rather than a container-only Compose hostname.
# LAZYCLOUD_OBJECT_STORE_PRESIGNED_ENDPOINT_URL=http://<docker-host>:9002

# Host ports. When changing the control-plane port, pass the same endpoint to
# `lazycloud login --endpoint http://localhost:<port>` and to
# LAZYCLOUD_GATEWAY_PUBLIC_HTTP_URL above.
LAZYCLOUD_COMPOSE_CONTROL_PLANE_PORT=8000
LAZYCLOUD_COMPOSE_TCP_INGRESS_PORT=1995
LAZYCLOUD_COMPOSE_POSTGRES_PORT=5432
LAZYCLOUD_COMPOSE_REDIS_PORT=6379
LAZYCLOUD_COMPOSE_OBJECT_STORE_PORT=9002
LAZYCLOUD_COMPOSE_OBJECT_STORE_ADMIN_PORT=3903

# The SNI suffix TCP routes are published under. Routes resolve by
# `{stub_id}-{port}.{external_host}`, so a name the client cannot resolve is a
# route that connects to nothing.
LAZYCLOUD_TCP_INGRESS_EXTERNAL_HOST=tcp.localhost

# Which Compose profiles start. Empty runs the whole stack: the `container-worker`
# service is the shared platform fleet and the `agent` service runs the joined
# machine, so both kinds of capacity a workload can land on are up. The optional
# profiles are `public-ingress` (cloudflared) and `tools` (the `cli` service).
# COMPOSE_PROFILES=

# Capacity the shared fleet advertises. The memory value also bounds the workers
# the agent creates; the agent's CPU ceiling is its own
# LAZYCLOUD_COMPOSE_AGENT_MAX_CPU_CORES, which defaults to 4 cores.
LAZYCLOUD_COMPOSE_CONTAINER_WORKER_CPU_MILLICORES=4000
LAZYCLOUD_COMPOSE_CONTAINER_WORKER_MEMORY_MIB=8192

# The pool the shared fleet registers into, which is also the pool a workspace
# schedules onto when it has no compute policy — rename it and that workspace names
# capacity nothing feeds. It must stay different from LAZYCLOUD_COMPOSE_SELF_HOSTED_POOL
# below: one name for both puts the joined machine in the same pool as the shared
# fleet, so work belonging to the account that owns the machine lands on platform
# capacity instead.
LAZYCLOUD_COMPOSE_CONTAINER_WORKER_POOL=lazycloud

# The second account. The joined machine belongs to it rather than to the
# administrator, so a workload from `default` and one from this account's
# workspace exercise both sides of the placement rule on every boot.
# LAZYCLOUD_COMPOSE_CUSTOMER_NAME=customer
# LAZYCLOUD_COMPOSE_CUSTOMER_WORKSPACE=tenant-customer
# LAZYCLOUD_COMPOSE_SELF_HOSTED_POOL=self-hosted

# The shared fleet's own identity and bridge. Its bridge must differ from every
# agent's: each allocator hands out addresses inside its own control-plane scope,
# so two on one segment issue the same address with no lock between them.
# LAZYCLOUD_COMPOSE_CONTAINER_WORKER_ID=compose-container-worker
# LAZYCLOUD_COMPOSE_CONTAINER_WORKER_MACHINE=compose-machine
# LAZYCLOUD_COMPOSE_CONTAINER_WORKER_POD_ADDRESS=container-worker
# LAZYCLOUD_COMPOSE_CONTAINER_WORKER_SERVICE_PORT=8910
# LAZYCLOUD_COMPOSE_CONTAINER_WORKER_NETWORK_PREFIX=compose-shared
# LAZYCLOUD_COMPOSE_SHARED_WORKER_BRIDGE=rt_br2
# LAZYCLOUD_COMPOSE_SHARED_WORKER_SUBNET=192.168.32.0/20
# LAZYCLOUD_COMPOSE_SHARED_WORKER_IPV6_SUBNET=fd00:abcf::/64

# The stack runs a shared platform fleet and one joined machine owned by a second
# account, which is the shape a customer sees: work lands on shared capacity unless
# their workspace names their own pool. Nothing coordinates the two workers — the
# fingerprint decides the machine id, and the bridge decides which addresses their
# containers get, with each allocator working inside its own control-plane scope, so
# a shared bridge is two allocators issuing one address with no lock between them.
# `deploy/README.md` holds the table.
# LAZYCLOUD_COMPOSE_AGENT_WORKER_BRIDGE=rt_br0
# LAZYCLOUD_COMPOSE_AGENT_WORKER_SUBNET=192.168.0.0/20
# LAZYCLOUD_COMPOSE_AGENT_WORKER_IPV6_SUBNET=fd00:abcd::/64

# The release this deployment runs. `uv run python deploy/release.py` publishes a
# release and writes this line itself; set it by hand only to move a deployment
# onto a release someone else published. The agent artifact version and digest,
# the URL serving it, the container-worker image, the customer authorization
# template, and the baked CPU AMIs are all read from the manifest it names —
# copying any of them here instead is what let a deployment hold five values from
# one release and one from another. Leave it unset for a control plane that runs
# no managed capacity and serves no published agent artifact.
# LAZYCLOUD_RELEASE_MANIFEST_URL=

# Where the published agent artifact lives, named on both sides of the mount
# because the two paths are not the same path. The COMPOSE_ one is the host
# directory bound into the control plane; the other is where the process reads it
# inside the container, and it must stay in step with the mount target.
# LAZYCLOUD_COMPOSE_AGENT_BINARY_DIR=./.lazycloud/agent-binarys
# LAZYCLOUD_AGENT_BINARY_DIR=/var/lib/lazycloud/agent-binarys

# Connected AWS is whatever these two values say it is: a control principal here
# and a connection template from the release this deployment names. Both absent
# is a stack with no connected AWS, which is the ordinary shape for local work.
# Setting this one means the capability turns on as soon as a release supplies
# the other, and the remote provider gate then requires an HTTPS gateway origin,
# so a local http:// gateway URL makes the control plane refuse to start. Run
# `uv run python deploy/connected-aws/bootstrap.py` to provision the principal
# and print the .env lines its stack outputs map to.
# LAZYCLOUD_AWS_CONNECTION_CONTROL_PRINCIPAL_ARN=

# The credential directory the control plane and scheduler mount at
# /run/lazycloud/aws, and the profile they select from it. A connected stack
# differs from a local one by these alone; the directory holds the role chain
# ending in the control principal, never root keys. See `deploy/README.md`.
#
# The profile is named the same here and in the chart, because it is the same
# profile: only the base of the chain differs, an operator's own credentials
# locally and the pod's identity in the cluster.
LAZYCLOUD_COMPOSE_AWS_CONFIG_DIR=$HOME/.lazycloud/compose-aws
LAZYCLOUD_COMPOSE_AWS_PROFILE=control
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# The hourly price per instance type, as a JSON object. This is the one managed
# capacity value a release cannot publish, so authoring it is what declares that
# this deployment intends to run managed AWS capacity at all. An empty object
# means no priced instance types and therefore no managed capacity.
#
# GPU AMIs are no longer set here. The release bakes and publishes them alongside
# the CPU catalog, because an AMI that carries drivers is a property of what was
# built, and a deployment naming its own would assert a driver no release made.
# A wrong figure does not fail. Offers are ranked by cost per node, so it
# silently changes which instance every workload lands on. Leave a type out
# rather than recording a zero for it: zero wins every comparison.
# LAZYCLOUD_AWS_CAPACITY_INSTANCE_HOURLY_MICROS={"m7i.large": 100800, "c7i.large": 89250}

# Cloudflare tunnel for the `public-ingress` profile. The credentials file is
# mounted into cloudflared; the client IP header names which forwarded-for header
# the API trusts, and must stay empty unless a proxy is actually setting it.
# LAZYCLOUD_PUBLIC_INGRESS_CREDENTIALS_FILE=
# LAZYCLOUD_PUBLIC_INGRESS_CLIENT_IP_HEADER=

# Registry that built images are pushed to and pulled from. Empty keeps builds
# in the stack's own object-store-backed registry.
# LAZYCLOUD_BUILD_REGISTRY=
# LAZYCLOUD_BUILD_REGISTRY_CREDENTIALS=
# LAZYCLOUD_BUILD_REGISTRY_CREDENTIALS_SECRET=

# Service tokens the stack generates for itself: the cache-token service writes
# them into volumes on first start. Set them only to pin a value
# across a volume reset, or to rotate the cache token, where the previous value
# keeps in-flight callers working until they reconnect.
# LAZYCLOUD_CONTAINER_WORKER_TOKEN=
# LAZYCLOUD_CONTAINER_SERVICE_TOKEN=
# LAZYCLOUD_CACHE_SERVICE_TOKEN=
# LAZYCLOUD_CACHE_SERVICE_PREVIOUS_TOKEN=

# Destinations outside this app that the marketing pages link to. Baked into the
# web bundle when the image is built, so changing either needs a rebuild. Left
# unset, the pages render no Examples or Docs entry at all rather than a control
# that goes nowhere.
# LAZYCLOUD_EXAMPLES_URL=
# LAZYCLOUD_DOCS_URL=
