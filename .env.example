ENV=dev
ADMIN_API_KEY={ADMIN_API_KEY}

FLY_API_TOKEN={FLY_API_TOKEN}
FLY_ORG_NAME={FLY_ORG_NAME}

# below is the database url for local development when running and exposing with docker compose
DATABASE_URL=postgresql+asyncpg://machines-dev:password@localhost:5432/machines
REDIS_URL=redis://localhost:6379

# rate limit for the api
RATE_LIMIT=50/minute
