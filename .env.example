ENV=dev
ADMIN_API_KEY={ADMIN_API_KEY}

FLY_API_TOKEN={FLY_API_TOKEN}
FLY_ORG_NAME={FLY_ORG_NAME}

# below database url for local development when running and exposing with docker compose
DATABASE_URL=postgresql+asyncpg://machines-dev:password@localhost:5432/machines
REDIS_URL=redis://localhost:6379

# rate limit for the api
RATE_LIMIT=50/minute

# defined pricing values for volume, dedicated ipv4, and data egress
LAZYCLOUD_UPCHARGE=0.30
VOLUME_PRICE=0.18
DEDICATED_IPV4_PRICE=3.00
DATA_EGRESS_PRICE=0.03


# AWS Credentials
AWS_ACCESS_KEY_ID={AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY={AWS_SECRET_ACCESS_KEY}
AWS_REGION={AWS_REGION}
AWS_ROUTE53_ZONE_ID={AWS_ROUTE53_ZONE_ID}

# Stripe access keys
STRIPE_SECRET_KEY={STRIPE_SECRET_KEY}
STRIPE_PUBLISHABLE_KEY={STRIPE_PUBLISHABLE_KEY}
