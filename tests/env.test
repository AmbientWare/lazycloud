# Configuration the test suite requires, so a run does not inherit whatever the
# developer's `.env` happens to point at. The harness loads this into the
# environment, which outranks `.env` in settings resolution.
#
# Endpoints resolve nowhere on purpose: a unit test that reaches a real object
# store should fail loudly rather than quietly depend on one running locally.
LAZYCLOUD_BACKEND_ROUTE_AUTH_KEY=test-backend-route-auth-key-0123456789abcdef
LAZYCLOUD_OBJECT_STORE_BUCKET=lazycloud-objects
LAZYCLOUD_OBJECT_STORE_ENDPOINT_URL=http://object-store.invalid:9000
LAZYCLOUD_OBJECT_STORE_PRESIGNED_ENDPOINT_URL=http://object-store.invalid:9000
LAZYCLOUD_OBJECT_STORE_REGION_NAME=us-east-1
LAZYCLOUD_OBJECT_STORE_ACCESS_KEY_ID=test-access-key
LAZYCLOUD_OBJECT_STORE_SECRET_ACCESS_KEY=test-secret-key
LAZYCLOUD_OBJECT_STORE_FORCE_PATH_STYLE=true
LAZYCLOUD_GATEWAY_PUBLIC_HTTP_URL=http://gateway.invalid:8000
LAZYCLOUD_GATEWAY_RUNTIME_HTTP_URL=http://gateway.invalid:8000
# The public client is the one settings class that reads `.env` by design, so a
# run would otherwise resolve the developer's real endpoint and admin token.
# Every field it exposes is pinned here; the harness clears the rest.
LAZYCLOUD_ENDPOINT=http://127.0.0.1:9000
LAZYCLOUD_TOKEN=
LAZYCLOUD_WORKSPACE=
LAZYCLOUD_PROFILE=
