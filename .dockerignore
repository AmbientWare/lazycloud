**/__pycache__/
*.py[cod]
**/*.py[cod]
.pytest_cache/
.ruff_cache/
.git/
*.egg-info/
build/
**/build/
dist/
**/dist/
node_modules/
**/node_modules/
.env
.env.local
test-results/
**/test-results/
playwright-report/
**/playwright-report/
coverage/
