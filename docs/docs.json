{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "LazyCloud",
  "description": "Documentation for LazyCloud, a Python-first serverless compute platform for functions, endpoints, pods, and sandboxes.",
  "colors": {
    "primary": "#006b9a",
    "light": "#66cbff",
    "dark": "#4dbce8"
  },
  "logo": {
    "light": "/logo.png",
    "dark": "/logo.png",
    "href": "https://lazycloud.dev"
  },
  "favicon": "/favicon.png",
  "navbar": {
    "links": [
      {
        "label": "lazycloud.dev",
        "href": "https://lazycloud.dev"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open dashboard",
      "href": "https://lazycloud.dev/dashboard"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "getting-started/installation",
          "getting-started/quickstart",
          "getting-started/first-endpoint"
        ]
      },
      {
        "group": "Examples",
        "pages": [
          "examples/index",
          "examples/openai-compatible-llm",
          "examples/train-yolo-object-detector",
          "examples/document-processing-asgi",
          "examples/sandboxed-coding-agent",
          "examples/parallel-parquet-s3"
        ]
      },
      {
        "group": "Workloads",
        "pages": [
          "concepts/apps",
          "concepts/functions",
          "concepts/endpoints",
          "concepts/schedules",
          "concepts/pods",
          "concepts/sandboxes",
          "concepts/images"
        ]
      },
      {
        "group": "Data and state",
        "pages": [
          "concepts/volumes",
          "concepts/secrets",
          "concepts/queues-maps-signals",
          "concepts/artifacts",
          "concepts/tasks-and-logs"
        ]
      },
      {
        "group": "Account",
        "pages": [
          "platform/auth",
          "platform/plans",
          "platform/compute",
          "platform/domains",
          "platform/dashboard"
        ]
      },
      {
        "group": "CLI reference",
        "pages": [
          "cli/overview",
          "cli/deploy-and-run",
          "cli/tasks-and-logs",
          "cli/deployments-and-containers",
          "cli/storage",
          "cli/compute",
          "cli/auth",
          "cli/scaffolding"
        ]
      }
    ]
  },
  "footer": {
    "socials": {}
  }
}
