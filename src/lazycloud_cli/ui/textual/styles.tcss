/* Container base styles */
DeploymentsContainer,
SecretsDeploymentsContainer,
ServicesContainer,
ContentContainer,
SecretsContainer {
    border: round $primary;
    padding: 1;
    height: 1fr;
}

SecretsContainer {
    height: 5;
}

DeploymentsContainer:focus,
SecretsDeploymentsContainer:focus,
ServicesContainer:focus,
ContentContainer:focus,
SecretsContainer:focus,
DeploymentsContainer:focus-within,
SecretsDeploymentsContainer:focus-within,
ServicesContainer:focus-within,
ContentContainer:focus-within,
SecretsContainer:focus-within {
    border: round $accent;
}

/* Section and DataTable base styles */
SectionContainer {
    border: round $primary;
    padding: 0 1;
    height: auto;
    border-title-color: $accent;
}

DataTable {
    border: round $primary;
    background: transparent;
    height: auto;
    border-title-color: $accent;
}

DataTable:focus {
    border: round $accent;
    border-title-color: $accent;
}

DataTable > .datatable--cursor {
    background: $accent 40%;
    text-style: none;
}

DataTable > .datatable--hover {
    background: $accent 25%;
}

DataTable > .datatable--header {
    background: transparent;
    color: $primary;
    text-style: bold;
    border-bottom: solid $primary;
}

DataTable > .datatable--even,
DataTable > .datatable--odd {
    background: transparent;
    border-bottom: solid $primary;
}

#secrets-table,
#deployment-services-table,
#deployment-volumes-table,
#deployment-networks-table,
#service-resources-table {
    border: none;
}

#secrets-table {
    height: 100%;
}

/* Modal and ListView styles */
ModalScreen {
    background: $surface;
}

ModalContainer {
    border: round $primary;
}

ListView {
    background: transparent;
    border: none;
}

ListItem {
    background: transparent;
}

ListItem:hover {
    background: $accent 20%;
}

ListItem.-highlight {
    background: $accent 30%;
}

Container > .container--title {
    color: $accent;
}

/* Modal base styles */
#success-modal,
#error-modal,
#confirm-modal,
#input-modal {
    width: 60;
    height: auto;
    max-height: 20;
    padding: 2 4;
}

#success-modal { border: round $success; }
#error-modal { border: round $error; }
#confirm-modal { border: round $warning; }
#input-modal { border: round $accent; }

#success-header,
#error-header,
#confirm-header,
#input-header,
#success-message,
#error-message,
#confirm-message,
#input-message {
    text-align: center;
}

#success-header,
#error-header,
#confirm-header,
#input-header {
    margin: 0 0 1 0;
}

#success-message,
#error-message,
#confirm-message,
#input-message {
    margin: 1 2;
}

#input-field {
    width: 100%;
    margin: 1 0;
}

#view-secret-modal {
    width: 60;
    height: auto;
    padding: 2;
    border: round $primary;
}

#view-secret-header,
#view-secret-key {
    text-align: center;
    margin: 0 0 1 0;
}

#view-secret-key {
    color: $accent;
}

#secret-input,
#input-field {
    width: 100%;
    margin: 1 0;
}

#modal-wrapper {
    align: center middle;
    width: 100%;
    height: 100%;
    background: transparent;
}

#content-modal-container {
    padding: 2 4;
    background: transparent;
}

#content-modal-container.modal-default { border: round $primary; }
#content-modal-container.modal-focus { border: round $accent; }
#content-modal-container.modal-success { border: round $success; }
#content-modal-container.modal-warning { border: round $warning; }
#content-modal-container.modal-error { border: round $error; }

#modal-header {
    dock: top;
    height: 1;
    margin: 0 0 1 0;
    text-align: center;
}

/* Status colors */
.status-running,
.status-ready,
.status-active { color: $success; }

.status-pending,
.status-waiting,
.status-partially-running { color: $warning; }

.status-error,
.status-failed { color: $error; }

.status-stopped { color: $primary 50%; }

/* Text colors */
.text-primary { color: $foreground; }
.text-muted { color: $primary; }

/* Usage Dashboard Styles */
#usage-main-container {
    width: 100%;
    height: 100%;
    border: round $primary;
    padding: 1;
    layout: vertical;
}

#usage-main-container:focus,
#usage-main-container:focus-within {
    border: round $accent;
}

#error-container {
    width: 60;
    height: auto;
    border: round $error;
    padding: 2;
}

/* Top section: billing period + sparkline (stacked vertically) */
#usage-top-section {
    height: auto;
    width: 100%;
    margin: 0 0 1 0;
    layout: vertical;
}

#usage-overview-section {
    width: 100%;
    height: auto;
    padding: 0;
}

#usage-trend-section {
    width: 100%;
    height: auto;
    padding: 0;
}

#usage-trend-section SectionContainer {
    padding: 0 1;
    height: auto;
}

#usage-sparkline {
    border: none;
    padding: 0;
    margin: 0;
}

#usage-sparkline > .sparkline--max-color { color: $accent; }
#usage-sparkline > .sparkline--min-color { color: $accent 30%; }

#usage-content {
    padding: 1;
}

/* Bottom section: deployments + services */
#usage-horizontal-split {
    height: 1fr;
    width: 100%;
}

#usage-left-panel {
    width: 25%;
    height: 100%;
    layout: vertical;
}

#active-deployments-container,
#inactive-deployments-container {
    border: round $primary;
    padding: 0;
    height: 1fr;
}

#active-deployments-container:focus-within,
#inactive-deployments-container:focus-within {
    border: round $accent;
}

#active-deployments-list,
#inactive-deployments-list {
    height: 100%;
}

#usage-right-panel {
    width: 75%;
    height: 100%;
    margin: 0 0 0 1;
    layout: vertical;
}

#deployment-breakdown-section {
    width: 100%;
    height: 100%;
    border: round $primary;
    padding: 1;
}

#deployment-breakdown-section:focus-within {
    border: round $accent;
}

#breakdown-scroll {
    width: 100%;
    height: 100%;
}

#usage-metrics-table,
#services-cost-table,
#volumes-cost-table,
#workspace-totals-table {
    border: none;
}

#deployment-cost-title {
    margin: 0 0 1 0;
}

#usage-breakdown-table {
    height: 1fr;
}

#volume-usage-table {
    height: auto;
    min-height: 6;
}

#error-message {
    padding: 2;
    text-align: center;
}

#cost-summary-content,
#usage-summary-content {
    padding: 0 1;
}
