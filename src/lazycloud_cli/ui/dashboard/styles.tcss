DeploymentsContainer {
    height: 1fr;
    padding: 1;
}

ServicesContainer {
    height: 1fr;
    padding: 1;
}

SecretsContainer {
    height: 5;
    padding: 1;
}

DeploymentsContainer,
SecretsDeploymentsContainer,
ServicesContainer,
ContentContainer,
SecretsContainer {
    border: round $primary;
}

DeploymentsContainer:focus,
SecretsDeploymentsContainer:focus,
ServicesContainer:focus,
ContentContainer:focus,
SecretsContainer:focus,
DeploymentsContainer:focus-within,
SecretsDeploymentsContainer:focus-within,
ServicesContainer:focus-within,
ContentContainer:focus-within,
SecretsContainer:focus-within {
    border: round $accent;
}

SectionContainer {
    border: round $primary;
    padding: 0 1;
    height: auto;
    border-title-color: $accent;
}

DataTable {
    border: round $primary;
    background: transparent;
    height: auto;
    border-title-color: $accent;
}

DataTable:focus {
    border: round $accent;
    border-title-color: $accent;
}

DataTable > .datatable--cursor {
    background: $accent 40%;
    text-style: none;
}

DataTable > .datatable--hover {
    background: $accent 25%;
}

DataTable > .datatable--header {
    background: transparent;
    color: $primary;
    text-style: bold;
    border-bottom: solid $primary;
}

DataTable > .datatable--even,
DataTable > .datatable--odd {
    background: transparent;
    border-bottom: solid $primary;
}

#secrets-table,
#deployment-services-table,
#deployment-volumes-table,
#deployment-networks-table,
#service-resources-table {
    border: none;
}

#secrets-table {
    height: 100%;
}

ModalScreen {
    background: $surface;
}

ModalContainer {
    border: round $primary;
}

ListView {
    background: transparent;
    border: none;
}

ListItem {
    background: transparent;
}

ListItem:hover {
    background: $accent 20%;
}

ListItem.-highlight {
    background: $accent 30%;
}

Container > .container--title {
    color: $accent;
}

#success-modal, #error-modal, #confirm-modal, #input-modal {
    width: 60;
    height: auto;
    max-height: 20;
    padding: 2 4;
}

#success-modal {
    border: round $success;
}

#error-modal {
    border: round $error;
}

#confirm-modal {
    border: round $warning;
}

#input-modal {
    border: round $accent;
}

#success-header, #error-header, #confirm-header, #input-header {
    text-align: center;
    margin: 0 0 1 0;
}

#success-message, #error-message, #confirm-message, #input-message {
    text-align: center;
    margin: 1 2;
}

#input-field {
    width: 100%;
    margin: 1 0;
}

#view-secret-modal {
    width: 60;
    height: auto;
    padding: 2;
    border: round $primary;
}

#view-secret-header {
    text-align: center;
    margin: 0 0 1 0;
}

#view-secret-key {
    text-align: center;
    margin: 0 0 1 0;
    color: $accent;
}

#secret-input {
    width: 100%;
    margin: 1 0;
}

#modal-wrapper {
    align: center middle;
    width: 100%;
    height: 100%;
    background: transparent;
}

#content-modal-container {
    padding: 2 4;
    background: transparent;
}

#content-modal-container.modal-default {
    border: round $primary;
}

#content-modal-container.modal-focus {
    border: round $accent;
}

#content-modal-container.modal-success {
    border: round $success;
}

#content-modal-container.modal-warning {
    border: round $warning;
}

#content-modal-container.modal-error {
    border: round $error;
}

#modal-header {
    dock: top;
    height: 1;
    margin: 0 0 1 0;
    text-align: center;
}

.status-running, .status-ready, .status-active {
    color: $success;
}

.status-pending, .status-waiting, .status-partially-running {
    color: $warning;
}

.status-error, .status-failed {
    color: $error;
}

.status-stopped {
    color: $primary 50%;
}

.text-primary {
    color: $foreground;
}

.text-muted {
    color: $primary;
}
