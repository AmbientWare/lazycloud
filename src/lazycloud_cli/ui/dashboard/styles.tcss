/* Dashboard Styles */

/* Left column container heights */
DeploymentsContainer {
    height: 1fr;
    padding: 1;
}

ServicesContainer {
    height: 1fr;
    padding: 1;
}

SecretsContainer {
    height:5;
    padding: 1;
}

/* Main container borders */
DeploymentsContainer,
SecretsDeploymentsContainer,
ServicesContainer,
ContentContainer,
SecretsContainer {
    border: round $primary;
}

/* Focused main containers get accent color border */
DeploymentsContainer:focus,
SecretsDeploymentsContainer:focus,
ServicesContainer:focus,
ContentContainer:focus,
SecretsContainer:focus,
DeploymentsContainer:focus-within,
SecretsDeploymentsContainer:focus-within,
ServicesContainer:focus-within,
ContentContainer:focus-within,
SecretsContainer:focus-within {
    border: round $accent;
}

/* Section containers - subtle styling with accent titles */
SectionContainer {
    border: round $primary;
    padding: 0 1;
    height: auto;
    border-title-color: $accent;  /* Accent color for section titles */
}

/* Data tables */
DataTable {
    border: round $primary;
    background: transparent;
    height: auto;
}

/* Secrets table should fill the container */
#secrets-table {
    height: 100%;
    border: none;
}

DataTable:focus {
    border: round $accent;
    border-title-color: $accent;
}

/* DataTable rows - very subtle highlighting */
DataTable > .datatable--cursor {
    background: $accent 15%;  /* Lighter highlight */
    text-style: none;
}

DataTable > .datatable--hover {
    background: $accent 10%;  /* Even lighter hover */
}

/* DataTable headers - accent color with underline separator */
DataTable > .datatable--header {
    background: transparent;  /* No background on headers */
    color: $accent;
    text-style: bold;
    border-bottom: solid $primary;
}

/* Row separators */
DataTable > .datatable--even,
DataTable > .datatable--odd {
    background: transparent;
    border-bottom: solid $primary;
}

/* Modal backdrop with 95% black background */
ModalScreen {
    background: black 95%;
}

/* Modal containers */
ModalContainer {
    border: round $primary;
}

/* Ensure ListViews have transparent backgrounds */
ListView {
    background: transparent;
    border: none;
}

/* ListItem styling - default transparent, highlighted with accent */
ListItem {
    background: transparent;
}

ListItem:hover {
    background: $accent 20%;
}

ListItem.-highlight {
    background: $accent 30%;
}

/* Add subtle accent to container titles */
Container > .container--title {
    color: $accent;
}

/* Modal styling */
#success-modal, #error-modal, #confirm-modal, #input-modal {
    width: 60;
    height: auto;
    max-height: 20;
    padding: 2 4;
}

#success-modal {
    border: round $success;
}

#error-modal {
    border: round $error;
}

#confirm-modal {
    border: round $warning;
}

#input-modal {
    border: round $accent;
}

#success-header, #error-header, #confirm-header, #input-header {
    text-align: center;
    margin: 0 0 1 0;
}

#success-message, #error-message, #confirm-message, #input-message {
    text-align: center;
    margin: 1 2;
}

#input-field {
    width: 100%;
    margin: 1 0;
}

/* View/Edit Secret Modal styling */
#view-secret-modal {
    width: 60;
    height: auto;
    padding: 2;
    border: round $primary;
}

#view-secret-header {
    text-align: center;
    margin: 0 0 1 0;
}

#view-secret-key {
    text-align: center;
    margin: 0 0 1 0;
    color: $accent;
}

#secret-input {
    width: 100%;
    margin: 1 0;
}

/* Content modal styling */
#modal-wrapper {
    align: center middle;
    width: 100%;
    height: 100%;
    background: transparent;
}

#content-modal-container {
    padding: 2 4;
    background: transparent;
}

#content-modal-container.modal-default {
    border: round $primary;
}

#content-modal-container.modal-focus {
    border: round $accent;
}

#content-modal-container.modal-success {
    border: round $success;
}

#content-modal-container.modal-warning {
    border: round $warning;
}

#content-modal-container.modal-error {
    border: round $error;
}

#modal-header {
    dock: top;
    height: 1;
    margin: 0 0 1 0;
    text-align: center;
}

/* Status classes for dynamic status styling */
.status-running, .status-ready, .status-active {
    color: $success;
}

.status-pending, .status-waiting, .status-partially-running {
    color: $warning;
}

.status-error, .status-failed {
    color: $error;
}

.status-stopped {
    color: $primary 50%;
}

/* List item text colors */
.text-primary {
    color: $foreground;
}

.text-muted {
    color: $primary;
}
