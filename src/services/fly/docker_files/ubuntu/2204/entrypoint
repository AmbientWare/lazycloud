#!/bin/bash

set -e

# Helper function to check if an item is in an array
# Usage: is_in_array "item_to_check" "${array[@]}"
is_in_array() {
    local item="$1"
    shift
    local arr=("$@")
    for element in "${arr[@]}"; do
        if [[ "$element" == "$item" ]]; then
            return 0 # Found
        fi
    done
    return 1 # Not found
}

# Enable better error tracking and debugging
exec > >(tee -a /var/log/entrypoint.log) 2>&1
echo "Starting setup... $(date)"

# Handle graceful shutdown
cleanup() {
    echo "Received shutdown signal, cleaning up..."
    # Try to unmount everything gracefully
    mount | grep "/data/root" | awk '{print $3}' | while IFS= read -r dir_to_unmount; do
        if [ -n "$dir_to_unmount" ]; then # Ensure dir_to_unmount is not empty
            echo "Attempting to unmount $dir_to_unmount..."
            umount "$dir_to_unmount" 2>/dev/null || true # Continue if unmount fails, maintaining original behavior
        fi
    done
    echo "Cleanup complete"
    exit 0 # Ensure script exits cleanly after trap
}
trap cleanup SIGTERM SIGINT

# Create the persistent root directory
mkdir -p /data/root

# Create /run/sshd for SSH privilege separation
mkdir -p /run/sshd

# Define directories that should NOT be copied or mounted
EXCLUDE_DIRS=("proc" "sys" "dev" "run" "mnt" "media" ".fly" "fly" "tmp"
              ".fly-upper-layer" "sbin.usr-is-merged" "bin.usr-is-merged"
              "lib.usr-is-merged")

# Create or ensure the tmp directory exists
echo "Setting up /tmp directory..."
mkdir -p "/data/root/tmp"
chmod 1777 "/data/root/tmp"

# Get current Ubuntu version for tracking
CURRENT_VERSION=$(grep VERSION_ID /etc/os-release | cut -d= -f2 | tr -d '"')
VERSION_FILE="/data/root/ubuntu_version.txt"

# Copy the entire root filesystem if it doesn't exist
if [ ! -f "/data/root/etc/passwd" ]; then
    echo "Initializing persistent root with Ubuntu $CURRENT_VERSION..."

    # Store version info
    echo "$CURRENT_VERSION" > "$VERSION_FILE"

    # Copy all system directories except excluded ones
    for dir in /*; do
        dir_name=$(basename "$dir")

        if is_in_array "$dir_name" "${EXCLUDE_DIRS[@]}"; then
            echo "Skipping copy of /$dir_name (excluded)."
            continue
        fi

        if [ -d "$dir" ]; then # Only process if it's a directory
            echo "Copying /$dir_name..."
            mkdir -p "/data/root/$dir_name"
            # Use rsync for more efficient copies with large files
            if command -v rsync >/dev/null 2>&1; then
                rsync -a --info=progress2 "$dir"/* "/data/root/$dir_name/" 2>/dev/null || true
            else
                cp -a "$dir"/* "/data/root/$dir_name/" 2>/dev/null || true
            fi
        fi
    done

    # Copy docker-entrypoint.d scripts if they exist
    if [ -d "/docker-entrypoint.d" ]; then
        echo "Copying docker-entrypoint.d scripts..."
        mkdir -p "/data/root/docker-entrypoint.d"
        cp -a /docker-entrypoint.d/* "/data/root/docker-entrypoint.d/"
        chmod +x /data/root/docker-entrypoint.d/*
    fi

    echo "Initial filesystem copy complete"
elif [ -f "$VERSION_FILE" ]; then
    STORED_VERSION=$(cat "$VERSION_FILE")
    echo "Found existing data volume with Ubuntu $STORED_VERSION (current: $CURRENT_VERSION)"
else
    echo "Found existing data volume but no version tracking"
fi

# Clean tmp directory at boot
echo "Cleaning /tmp directory..."
rm -rf /data/root/tmp/* /data/root/tmp/.* 2>/dev/null || true
chmod 1777 "/data/root/tmp"

# Create the user home directory
HOME_DIR=/data/home

echo "Ensure home directory"
mkdir -p $HOME_DIR

# Simplified mounting approach - mount each directory at root level
echo "Mounting persistent directories..."
for dir in /*; do
    dir_name=$(basename "$dir")

    if is_in_array "$dir_name" "${EXCLUDE_DIRS[@]}"; then
        echo "Skipping mount of /$dir_name (excluded or handled separately)."
        continue
    fi

    if [ -d "/data/root/$dir_name" ]; then # Check if corresponding data/root dir exists
        echo "Mounting $dir_name..."
        mount --bind "/data/root/$dir_name" "/$dir_name" || {
            echo "ERROR: Failed to mount /data/root/$dir_name to /$dir_name"
            # Continue despite errors to allow as much functionality as possible
        }
    # else # Optional: log if /data/root/$dir_name doesn't exist for a non-excluded dir
        # echo "Source /data/root/$dir_name not found for mounting /$dir_name."
    fi
done

# Mount the clean tmp directory
echo "Mounting clean /tmp directory..."
mount --bind "/data/root/tmp" "/tmp" || echo "ERROR: Failed to mount tmp directory"

# Now generate SSH host keys in the standard location (after mount)
echo "Generating SSH host keys if needed"
if [ ! -f "/etc/ssh/ssh_host_rsa_key" ]; then
    ssh-keygen -q -N "" -t rsa -f /etc/ssh/ssh_host_rsa_key
fi
if [ ! -f "/etc/ssh/ssh_host_ecdsa_key" ]; then
    ssh-keygen -q -N "" -t ecdsa -f /etc/ssh/ssh_host_ecdsa_key
fi
if [ ! -f "/etc/ssh/ssh_host_ed25519_key" ]; then
    ssh-keygen -q -N "" -t ed25519 -f /etc/ssh/ssh_host_ed25519_key
fi

echo "Setup SSH access for user ubuntu"
mkdir -p $HOME_DIR/.ssh
echo "Setting up authorized keys..."
# Clear existing authorized_keys file
> $HOME_DIR/.ssh/authorized_keys
# Split comma-separated keys and add each one
if [ ! -z "$AUTHORIZED_KEYS" ]; then
    IFS=',' read -ra KEYS <<< "$AUTHORIZED_KEYS"
    for key in "${KEYS[@]}"; do
        # Trim whitespace and add key if not empty
        key=$(echo "$key" | xargs)
        if [ ! -z "$key" ]; then
            echo "$key" >> $HOME_DIR/.ssh/authorized_keys
            echo "Added key to authorized_keys: ${key:0:30}..."
        fi
    done
else
    echo "WARNING: No SSH keys provided in AUTHORIZED_KEYS"
fi
chmod 700 $HOME_DIR/.ssh
chmod 600 $HOME_DIR/.ssh/authorized_keys
echo "SSH directory permissions set"
ls -la $HOME_DIR/.ssh/

echo "chowning your home to you"
chown -R ubuntu:ubuntu $HOME_DIR

# Set proper permissions for root filesystem - only if the directories exist
echo "Setting permissions on root filesystem..."
if [ -d "/data/root" ]; then
    chown -R root:root /data/root 2>/dev/null || true

    # Set executable permissions on binary directories if they exist
    for bindir in "/data/root/bin" "/data/root/usr/bin" "/data/root/usr/local/bin" "/data/root/opt/bin"; do
        if [ -d "$bindir" ]; then
            echo "Setting permissions for $bindir"
            chmod -R 755 "$bindir" 2>/dev/null || true
        fi
    done

    # Fix sudo permissions only if sudo exists
    if [ -f "/data/root/usr/bin/sudo" ]; then
        echo "Setting sudo permissions"
        chown root:root /data/root/usr/bin/sudo
        chmod 4755 /data/root/usr/bin/sudo
    fi
fi

# Run docker-entrypoint.d scripts
if [[ -d "/data/root/docker-entrypoint.d" ]]
then
echo "Running docker-entrypoint.d files"
/bin/run-parts --verbose /data/root/docker-entrypoint.d
fi

# Ensure proper SSH configuration file permissions
chmod 644 /etc/ssh/sshd_config
chmod 600 /etc/ssh/ssh_host_*_key
chmod 644 /etc/ssh/ssh_host_*_key.pub

# Success message
echo "==================================================="
echo "Setup complete! Starting SSH service..."
echo "Persistent storage initialized in /data/root"
echo "User home directory: $HOME_DIR"
echo "==================================================="

# Ensure SSH service is running in foreground mode
exec /usr/sbin/sshd -D -e "$@"
