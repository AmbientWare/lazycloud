region = "us-east-1"

control_plane_cidr = "10.80.0.0/16"

# Addresses that may reach the Kubernetes API from outside the VPC. The machine
# `terraform apply` runs from must be listed; nothing else outside the VPC needs
# it. `curl https://checkip.amazonaws.com` prints yours.
cluster_api_cidrs = ["203.0.113.7/32"]
