{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "release",
    "aws",
    "runtime",
    "fleet",
    "database",
    "serviceAccounts",
    "secrets"
  ],
  "properties": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active"],
      "properties": {
        "active": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generation", "manifest_url", "target"],
          "properties": {
            "generation": {"type": "integer", "minimum": 1},
            "manifest_url": {"type": "string", "pattern": "^https://[^\\s]+/manifest\\.json$"},
            "target": {"type": "object", "required": ["version", "source_revision", "worker_image", "agent"]}
          }
        }
      }
    },
    "aws": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region"
      ],
      "properties": {
        "region": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "controlPlane": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 2,
          "maximum": 32
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "poolSize",
            "maxOverflow"
          ],
          "properties": {
            "poolSize": {
              "type": "integer",
              "minimum": 1
            },
            "maxOverflow": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "scheduler": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 2
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "poolSize",
            "maxOverflow"
          ],
          "properties": {
            "poolSize": {
              "type": "integer",
              "minimum": 1
            },
            "maxOverflow": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "minReadySeconds": {
          "type": "integer",
          "minimum": 1
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "properties": {
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "poolSize",
            "maxOverflow"
          ],
          "properties": {
            "poolSize": {
              "type": "integer",
              "minimum": 1
            },
            "maxOverflow": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "wireguard": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 2
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "poolSize",
            "maxOverflow"
          ],
          "properties": {
            "poolSize": {
              "type": "integer",
              "minimum": 1
            },
            "maxOverflow": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "cloudflared": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "cacheServer": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "repositoryPrefix",
        "tag",
        "artifacts"
      ],
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "repositoryPrefix": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "artifacts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "pattern": "@sha256:[a-f0-9]{64}$"}
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "required": [
        "LAZYCLOUD_RELEASE_MANIFEST_URL",
        "LAZYCLOUD_STRIPE_ACCOUNT_ID",
        "LAZYCLOUD_WIREGUARD_PUBLIC_ENDPOINT",
        "LAZYCLOUD_PLATFORM_CAPACITY_HETZNER_IMAGES"
      ],
      "properties": {
        "LAZYCLOUD_RELEASE_MANIFEST_URL": {
          "type": "string",
          "pattern": "^https://[^\\s]+/manifest\\.json$"
        },
        "LAZYCLOUD_STRIPE_ACCOUNT_ID": {
          "type": "string",
          "pattern": "^acct_[A-Za-z0-9]+$"
        },
        "LAZYCLOUD_WIREGUARD_PUBLIC_ENDPOINT": {
          "type": "string",
          "pattern": "^[^:\\s]+:[0-9]{1,5}$"
        }
      }
    },
    "fleet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id",
        "role_arn",
        "networks"
      ],
      "properties": {
        "account_id": {
          "type": "string",
          "pattern": "^[0-9]{12}$"
        },
        "role_arn": {
          "type": "string",
          "minLength": 1
        },
        "networks": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(us-gov|us|af|ap|ca|cn|eu|il|me|mx|sa)-[a-z0-9-]+-[0-9]+$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "vpc_id",
              "subnet_ids",
              "security_group_id"
            ],
            "properties": {
              "vpc_id": {
                "type": "string",
                "minLength": 1
              },
              "subnet_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 2
              },
              "security_group_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxConnections",
        "poolerMaxConnections",
        "reserved"
      ],
      "properties": {
        "maxConnections": {
          "type": "integer",
          "minimum": 1
        },
        "poolerMaxConnections": {
          "type": "integer",
          "minimum": 1
        },
        "reserved": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "serviceAccounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlPlane",
        "scheduler",
        "secretsReader",
        "wireguardBootstrap"
      ],
      "properties": {
        "controlPlane": {
          "type": "string",
          "minLength": 1
        },
        "scheduler": {
          "type": "string",
          "minLength": 1
        },
        "secretsReader": {
          "type": "string",
          "minLength": 1
        },
        "wireguardBootstrap": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "map",
        "files",
        "documents",
        "readerRoleArn",
        "refreshInterval"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "refreshInterval": {
          "type": "string",
          "minLength": 1
        },
        "readerRoleArn": {
          "type": "string",
          "minLength": 1
        },
        "documents": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform",
            "operator",
            "wireguard"
          ],
          "properties": {
            "platform": {
              "type": "string",
              "minLength": 1
            },
            "operator": {
              "type": "string",
              "minLength": 1
            },
            "wireguard": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "map": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "platform",
              "operator"
            ]
          }
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "platform",
              "operator"
            ]
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "secretKeys",
          "runtimeKeys"
        ],
        "properties": {
          "secretKeys": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "runtimeKeys": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "secretRevisions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "className"
      ],
      "properties": {
        "className": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tunnel": {
      "type": "object",
      "properties": {
        "credentialsKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deploymentRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "infrastructureSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
