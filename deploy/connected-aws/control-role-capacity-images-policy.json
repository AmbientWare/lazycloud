{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectCapacityImages",
      "Effect": "Allow",
      "Action": ["ec2:DescribeImages"],
      "Resource": "*"
    },
    {
      "Sid": "ShareOwnedCapacityImages",
      "Effect": "Allow",
      "Action": ["ec2:ModifyImageAttribute"],
      "Resource": "arn:aws:ec2:*::image/*",
      "Condition": {
        "StringEquals": { "ec2:ResourceTag/cloud-pool:managed-by": "control-plane" }
      }
    }
  ]
}
