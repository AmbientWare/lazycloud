#!/usr/bin/env bash
set -euo pipefail

if ! command -v aws >/dev/null 2>&1; then
  if command -v apt-get >/dev/null 2>&1; then
    apt-get update
    apt-get install -y awscli
  elif command -v yum >/dev/null 2>&1; then
    yum install -y awscli
  fi
fi

curl -sfL https://get.k3s.io | INSTALL_K3S_EXEC="--disable traefik" sh -
TOKEN="$(cat /var/lib/rancher/k3s/server/node-token)"
aws ssm put-parameter --name "${node_token_parameter}" --type SecureString --value "$TOKEN" --overwrite
mkdir -p /etc/lazycloud
cat >/etc/lazycloud/lazycloud.env <<EOF
LAZYCLOUD_HOME=/var/lib/lazycloud
LAZYCLOUD_PORT=${control_plane_port}
EOF
