deployment = "lazycloud-prod"
region     = "us-east-1"

control_plane_cidr            = "10.80.0.0/16"
control_plane_instance_type   = "t4g.medium"
control_plane_root_volume_gib = 100

# Empty is the intended value. The tunnel, the tailnet and SSM are all outbound.
operator_ingress_cidrs = []

# Declares that this deployment runs managed AWS capacity, and ranks the
# instances it may launch. Leaving this out keeps managed capacity off.
# us-east-1 on-demand Linux, read from the AWS Pricing API on 2026-08-21.
#
# p5e.48xlarge is in the instance catalog and is deliberately absent here: AWS
# publishes no non-zero on-demand rate for it in this region, and a zero would
# win every cost comparison it entered. It becomes offerable the moment there is
# a real figure. Every other catalog type, H200 included through p5en.48xlarge,
# is priced and launchable.
#
# Read per type with capacitystatus=Used and the zero-priced reservation SKUs
# discarded. Taking the first SKU a query returns gives a capacity-reservation
# row priced at zero for several of the p5 family.
instance_hourly_micros = {
  "c7i.12xlarge"  = 2142000
  "c7i.16xlarge"  = 2856000
  "c7i.2xlarge"   = 357000
  "c7i.4xlarge"   = 714000
