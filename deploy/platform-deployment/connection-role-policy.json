{
  "Statement": [
    {
      "Action": [
        "autoscaling:DescribeAutoScalingGroups",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeInstances",
        "ec2:DescribeInternetGateways",
        "ec2:DescribeLaunchTemplates",
        "ec2:DescribeLaunchTemplateVersions",
        "ec2:DescribeRegions",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeVolumes",
        "ec2:DescribeVpcs",
        "sts:GetCallerIdentity"
      ],
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "Inventory"
    },
    {
      "Action": "ec2:CreateLaunchTemplate",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/cloud-pool:managed-by": "control-plane"
        }
      },
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "CreateTaggedLaunchTemplates"
    },
    {
      "Action": "ec2:CreateTags",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/cloud-pool:managed-by": "control-plane",
          "ec2:CreateAction": "CreateLaunchTemplate"
        }
      },
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "TagOnlyDuringOwnedCreate"
    },
    {
      "Action": "autoscaling:CreateAutoScalingGroup",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/cloud-pool:managed-by": "control-plane"
        }
      },
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "CreateTaggedAutoScalingGroups"
    },
    {
      "Action": [
        "ec2:CreateLaunchTemplateVersion",
        "ec2:DeleteLaunchTemplate",
        "ec2:ModifyLaunchTemplate"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/cloud-pool:managed-by": "control-plane"
        }
      },
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "ManageTaggedLaunchTemplates"
    },
    {
      "Action": [
        "autoscaling:DeleteAutoScalingGroup",
        "autoscaling:SetDesiredCapacity",
        "autoscaling:SetInstanceProtection",
        "autoscaling:TerminateInstanceInAutoScalingGroup",
        "autoscaling:UpdateAutoScalingGroup"
      ],
      "Condition": {
        "StringEquals": {
          "autoscaling:ResourceTag/cloud-pool:managed-by": "control-plane"
        }
      },
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "ManageTaggedAutoScalingGroups"
    },
    {
      "Action": "ec2:RunInstances",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/cloud-pool:managed-by": "control-plane"
        }
      },
      "Effect": "Allow",
      "Resource": [
        "arn:aws:ec2:*:*:instance/*",
        "arn:aws:ec2:*:*:volume/*"
      ],
      "Sid": "RunTaggedInstanceResources"
    },
    {
      "Action": "ec2:RunInstances",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/cloud-pool:managed-by": "control-plane"
        }
      },
      "Effect": "Allow",
      "Resource": [
        "arn:aws:ec2:*:*:launch-template/*",
        "arn:aws:ec2:*:*:security-group/*",
        "arn:aws:ec2:*:*:subnet/*"
      ],
      "Sid": "UseManagedInstanceLaunchResources"
    },
    {
      "Action": "ec2:RunInstances",
      "Effect": "Allow",
      "Resource": "arn:aws:ec2:*:*:image/*",
      "Sid": "UseRegionalImagesForInstances"
    },
    {
      "Action": "ec2:RunInstances",
      "Effect": "Allow",
      "Resource": "arn:aws:ec2:*:*:network-interface/*",
      "Sid": "CreateInstanceNetworkInterfaces"
    },
    {
      "Action": "ec2:CreateTags",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/cloud-pool:managed-by": "control-plane",
          "ec2:CreateAction": "RunInstances"
        }
      },
      "Effect": "Allow",
      "Resource": [
        "arn:aws:ec2:*:*:instance/*",
        "arn:aws:ec2:*:*:volume/*"
      ],
      "Sid": "TagManagedInstancesOnLaunch"
    },
    {
      "Action": "iam:CreateServiceLinkedRole",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "autoscaling.amazonaws.com"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:iam::*:role/aws-service-role/autoscaling.amazonaws.com/AWSServiceRoleForAutoScaling",
      "Sid": "CreateAutoScalingServiceRole"
    },
    {
      "Action": [
        "iam:CreateInstanceProfile",
        "iam:CreateRole"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/cloud-pool:managed-by": "control-plane"
        }
      },
      "Effect": "Allow",
      "Resource": [
        "arn:aws:iam::*:instance-profile/compute-node-*",
        "arn:aws:iam::*:role/compute-node-*"
      ],
      "Sid": "CreateManagedNodeIdentity"
    },
    {
      "Action": [
        "iam:AddRoleToInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:GetInstanceProfile",
        "iam:GetRole",
        "iam:ListRolePolicies",
        "iam:PutRolePolicy",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:TagRole",
        "iam:UntagInstanceProfile",
        "iam:UntagRole"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:iam::*:instance-profile/compute-node-*",
        "arn:aws:iam::*:role/compute-node-*"
      ],
      "Sid": "ManageOwnedNodeIdentity"
    },
    {
      "Action": "iam:PassRole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:iam::*:role/compute-node-*",
      "Sid": "PassOwnedNodeRole"
    }
  ],
  "Version": "2012-10-17"
}
