# The deployment's name, namespace, and the prefix of every AWS name it owns.
deployment = "lazycloud-prod"
region     = "us-east-1"

# Also pass the verified Hetzner Node Images artifact with
# -var-file=/absolute/path/to/hetzner-images.tfvars.json. Tokens stay in the
# operator secret; deploy/PROVIDERS.md describes the common provisioning flow.

# The GitHub environment whose jobs may assume this deployment's deploy role.
github_environment = "prod"

# The tunnel this deployment serves through, from its own deploy/cloudflare apply.
cloudflare_state_key = "cloudflare/production.tfstate"

# A second deployment on the same cluster needs a CIDR that overlaps neither
# this one nor the cluster's 10.80.0.0/16.
fleet_cidr = "10.84.0.0/16"
