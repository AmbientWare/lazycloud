# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:6432/dbname
DB_SECRET_KEY=your-fernet-key-here

# Redis
REDIS_URL=redis://localhost:6379

# AWS
AWS_ACCOUNT_ID=000000000000
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ECR_BASE_ROLE_ARN=arn:aws:iam::000000000000:role/LazyCloudECRBaseRole
AWS_ROUTE53_ZONES={"example.com": "ZONE_ID"}
AWS_ENDPOINT_URL=http://localstack:4566
LOCALSTACK_AUTH_TOKEN=your-localstack-token
LOCALSTACK_HOST=localhost

# Kubernetes
KUBECONFIG=/root/.kube/config
PROMETHEUS_URL=http://localhost:9090

# Prefect
PREFECT_API_URL=http://localhost:4200/api
PREFECT_LOGGING_LOG_PRINTS=true
PREFECT_LOCAL_STORAGE_PATH=/task-storage
PREFECT_RESULTS_PERSIST_BY_DEFAULT=true
PREFECT_SERVER_API_HOST=0.0.0.0

# WorkOS
WORKOS_CLIENT_ID=your-client-id

# Sentry
SENTRY_DSN=your-sentry-dsn

# Polar
POLAR_ORGANIZATION_ID=your-org-id
POLAR_ACCESS_TOKEN=your-polar-token
IS_POLAR_SANDBOX=true

# Depot
DEPOT_API_TOKEN=your-depot-token
DEPOT_ORG_ID=your-depot-org-id

# Email
RESEND_API_KEY=your-resend-api-key
SUPPORT_EMAIL=support@example.com

# Auth
ADMIN_API_KEY=your-admin-api-key
