# App
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
API_PREFIX=/v1

# Database
DATABASE_URL=postgresql://user:password@localhost:6432/dbname

# Redis
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Workos
WORKOS_CLIENT_ID=your-workos-client-id
WORKOS_API_KEY=your-workos-api-key
WORKOS_COOKIE_PASSWORD=generate-password
WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Polar
POLAR_ACCESS_TOKEN=your-polar-token
IS_POLAR_SANDBOX=true

# Email
RESEND_API_KEY=your-resend-api-key
SUPPORT_EMAIL=support@example.com

# Auth
ADMIN_API_KEY=your-admin-api-key

# Dev auth bypass (optional) - set to a user's API key to skip WorkOS auth in development
# helpful for running instance attached to staging
# DEV_API_KEY=sk_your_user_api_key
