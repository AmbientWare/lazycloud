/* ========================================
   MODAL COMPONENTS
   ======================================== */

ModalScreen {
    background: $surface;
}

BaseModalScreen {
    align: center middle;
}

ModalContainer {
    border: round $primary;
}

/* Standard modal types */
#success-modal,
#error-modal,
#confirm-modal,
#input-modal {
    width: 60;
    height: auto;
    max-height: 20;
    padding: 2 4;
}

#success-modal { border: round $success; }
#error-modal { border: round $error; }
#confirm-modal { border: round $warning; }
#input-modal { border: round $accent; }

/* Modal headers and messages */
#success-header,
#error-header,
#confirm-header,
#input-header,
#success-message,
#error-message,
#confirm-message,
#input-message {
    text-align: center;
}

#success-header,
#error-header,
#confirm-header,
#input-header {
    margin: 0 0 1 0;
}

#success-message,
#error-message,
#confirm-message,
#input-message {
    margin: 1 2;
}

/* Modal input fields */
#input-field,
#secret-input {
    width: 100%;
    margin: 1 0;
}

/* View secret modal */
#view-secret-modal {
    width: 60;
    height: auto;
    padding: 2;
    border: round $primary;
}

#view-secret-header,
#view-secret-key {
    text-align: center;
    margin: 0 0 1 0;
}

#view-secret-key {
    color: $accent;
}

/* Content modal */
#modal-wrapper {
    align: center middle;
    width: 100%;
    height: 100%;
    background: transparent;
}

#content-modal-container {
    padding: 2 4;
    background: transparent;
    width: auto;
    height: auto;
}

#content-modal-container.modal-default { border: round $primary; }
#content-modal-container.modal-focus { border: round $accent; }
#content-modal-container.modal-success { border: round $success; }
#content-modal-container.modal-warning { border: round $warning; }
#content-modal-container.modal-error { border: round $error; }

#modal-header {
    dock: top;
    height: 1;
    margin: 0 0 1 0;
    text-align: center;
}

/* Logs modal */
#logs-content {
    background: transparent;
    border: none;
    padding: 0;
    height: 1fr;
}
