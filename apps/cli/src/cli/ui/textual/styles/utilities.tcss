/* ========================================
   STATUS & TEXT UTILITY CLASSES
   ======================================== */

/* Status colors */
.status-running,
.status-ready,
.status-active {
    color: $success;
}

.status-pending,
.status-waiting,
.status-partially-running {
    color: $warning;
}

.status-error,
.status-failed {
    color: $error;
}

.status-stopped {
    color: $primary 50%;
}

/* Text utility classes */
.text-primary {
    color: $foreground;
}

.text-muted {
    color: $primary;
}
