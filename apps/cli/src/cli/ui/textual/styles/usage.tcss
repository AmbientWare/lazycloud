/* ========================================
   USAGE DASHBOARD FEATURE STYLES
   Usage tracking and cost breakdown
   ======================================== */

/* ========================================
   MAIN USAGE CONTAINER
   ======================================== */

#usage-main-container {
    width: 100%;
    height: 100%;
    border: round $primary;
    padding: 1;
    layout: vertical;
}

#usage-main-container:focus,
#usage-main-container:focus-within {
    border: round $accent;
}

#error-container {
    width: 60;
    height: auto;
    border: round $error;
    padding: 2;
}

#error-message {
    padding: 2;
    text-align: center;
}

/* ========================================
   USAGE DASHBOARD - TOP SECTION
   Overview and trend sparkline
   ======================================== */

#usage-top-section {
    height: auto;
    width: 100%;
    margin: 0 0 1 0;
    layout: vertical;
}

#usage-overview-section {
    width: 100%;
    height: auto;
    padding: 0;
}

#usage-trend-section {
    width: 100%;
    height: auto;
    padding: 0;
}

#usage-trend-section SectionContainer {
    padding: 0 1;
    height: auto;
}

#usage-sparkline {
    border: none;
    padding: 0;
    margin: 0;
}

#usage-sparkline > .sparkline--max-color { color: $accent; }
#usage-sparkline > .sparkline--min-color { color: $accent 30%; }

#usage-content {
    padding: 1;
}

/* ========================================
   USAGE DASHBOARD - SPLIT LAYOUT
   Deployments list + Cost breakdown
   ======================================== */

#usage-horizontal-split {
    height: 1fr;
    width: 100%;
}

/* Left panel - Active/Inactive deployments */
#usage-left-panel {
    width: 25%;
    height: 100%;
    layout: vertical;
}

#active-deployments-container,
#inactive-deployments-container {
    border: round $primary;
    padding: 0;
    height: 1fr;
}

#active-deployments-container:focus-within,
#inactive-deployments-container:focus-within {
    border: round $accent;
}

#active-deployments-list,
#inactive-deployments-list {
    height: 100%;
}

/* Right panel - Cost breakdown */
#usage-right-panel {
    width: 75%;
    height: 100%;
    margin: 0 0 0 1;
    layout: vertical;
}

#deployment-breakdown-section {
    width: 100%;
    height: 100%;
    border: round $primary;
    padding: 1;
}

#deployment-breakdown-section:focus-within {
    border: round $accent;
}

#deployment-breakdown-section > LoadingIndicator {
    background: transparent;
}

#deployment-breakdown-section.-loading {
    background: transparent;
}

#breakdown-scroll {
    width: 100%;
    height: 100%;
}

/* ========================================
   USAGE DASHBOARD - TABLES
   ======================================== */

#usage-metrics-table,
#services-cost-table,
#volumes-cost-table,
#workspace-totals-table {
    border: none;
}

#deployment-cost-title {
    margin: 0 0 1 0;
}

#usage-breakdown-table {
    height: 1fr;
}

#volume-usage-table {
    height: auto;
    min-height: 6;
}

#cost-summary-content,
#usage-summary-content {
    padding: 0 1;
}
